{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A jewelry item in the boutique",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the jewelry piece" },
        "slug": { "type": "string", "description": "URL-friendly name" },
        "category": { "type": "string", "description": "Main category" },
        "subcategory": { "type": "string", "description": "Subcategory or material" },
        "price": { "type": "number", "description": "Price in INR" },
        "priceOnRequest": { "type": "boolean", "description": "If true, show 'Price on Request'" },
        "shortDescription": { "type": "string", "description": "Brief summary" },
        "fullDescription": { "type": "string", "description": "Detailed description" },
        "thumbnailImage": { "type": "string", "description": "Main image URL" },
        "galleryImages": { "type": "array", "items": { "type": "string" }, "description": "Additional image URLs" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "quantity": { "type": "number", "description": "Available stock quantity" },
        "status": { "type": "string", "enum": ["in-stock", "stockout"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "category", "price", "thumbnailImage"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "wishlist": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "role"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "brandDescription": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "passwordConfigured": { "type": "boolean", "description": "Non-sensitive marker indicating that the admin created a Firebase Authentication password" },
        "cloudinaryCloudName": { "type": "string" },
        "cloudinaryUploadPreset": { "type": "string" }
      }
    },
    "HomepageContent": {
      "title": "Homepage Content",
      "description": "Admin-managed homepage hero carousel and ordered collection sections",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "heroEnabled": { "type": "boolean" },
        "heroAutoplaySeconds": { "type": "number" },
        "heroSlides": { "type": "array", "description": "Editable Cloudinary hero slides with text and button links" },
        "categoriesEnabled": { "type": "boolean" },
        "categoriesTitle": { "type": "string" },
        "categoryLimit": { "type": "number" },
        "sections": { "type": "array", "description": "Ordered homepage collection blocks with visibility and collection selection" },
        "quoteEnabled": { "type": "boolean" },
        "quoteText": { "type": "string" },
        "instagramEnabled": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of all jewelry products"
    },
    "users": {
      "schema": "UserProfile",
      "description": "Collection of user profiles"
    },
    "settings": {
      "schema": "Settings",
      "description": "Global application settings (stored in 'general' doc)"
    },
    "homepageSettings": {
      "schema": "HomepageContent",
      "description": "Homepage editor content stored in the public-readable, admin-writable settings/homepage document"
    }
  }
}
